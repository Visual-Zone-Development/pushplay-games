# Optional: your own image API key, for `npm run art -- <game-id>` (docs/game-design/generated-art.md).
# Games never need one: art drawn in code is the default. Copy this file to .env (gitignored) and set
# ONE key. In a cloud agent (Claude Code on the web, Codex), add it to the environment's variables instead.
# The key is only used on your machine or in your agent's session, never in a shipped game.

# OpenAI image models (native transparent backgrounds). About $0.05 per image at medium quality.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Google Gemini image models. About $0.04 per image.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Replicate: FLUX and many other models. About $0.003-$0.06 per image depending on the model.
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# When several keys are set, pick one: openai | gemini | replicate
# ART_PROVIDER=
