{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "games": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "players": {
            "type": [
              "string",
              "null"
            ]
          },
          "controls": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gamepad",
                  "keyboard-mapped"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "gamepad",
                    "keyboard",
                    "mouse",
                    "touch"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "online": {
            "type": "boolean"
          },
          "platform": {
            "type": "string",
            "const": "web"
          },
          "build": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "commit": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "builtAt": {
            "type": "string"
          },
          "assets": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "name",
                    "size",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "commit": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "logUrl": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "message",
                  "at"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "assets",
          "error"
        ],
        "additionalProperties": {}
      }
    },
    "repo": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "enum": [
        "single",
        "collection"
      ]
    },
    "kit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "games",
    "repo",
    "layout",
    "kit",
    "updatedAt"
  ],
  "additionalProperties": {}
}
